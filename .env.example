# Backend API base URL (server-only — used by server functions, never sent to the browser)
API_URL=http://localhost:8000/api/v1

# Same backend origin, but client-visible: used only to build direct file-download
# links (e.g. generated CV/cover-letter downloads). Not used for authenticated calls.
# In production this must be the backend's real public HTTPS origin (its API_BASE_URL).
VITE_API_URL=http://localhost:8000/api
